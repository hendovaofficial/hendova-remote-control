<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07132F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- BRAND -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HENDOVA"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Teknologi untuk Kebaikan"
            android:textColor="#AEB9D6"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="6dp" />

        <!-- DEVICE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perangkat Anda"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp" />

        <TextView
            android:id="@+id/deviceIdText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HDV-XXXXXX"
            android:textColor="#50E3A4"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="20dp"
            android:background="#142957" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DAFTARKAN PERANGKAT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#6C2BFF"
            android:layout_marginTop="16dp" />

        <!-- REMOTE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kendalikan Perangkat Lain"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="36dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masukkan ID perangkat target untuk meminta koneksi."
            android:textColor="#AEB9D6"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/remoteIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: HDV-123456"
            android:textColor="#FFFFFF"
            android:textColorHint="#8B99BA"
            android:inputType="text"
            android:padding="16dp"
            android:backgroundTint="#536DAA"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/controlButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MINTA KONEKSI"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#176BFF"
            android:layout_marginTop="16dp" />

        <!-- BAGIKAN LAYAR -->

        <Button
            android:id="@+id/screenCaptureButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BAGIKAN LAYAR"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#50A8FF"
            android:layout_marginTop="16dp" />

        <!-- STATUS -->

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Ready"
            android:textColor="#50E3A4"
            android:textSize="16sp"
            android:layout_marginTop="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart • Secure • Together"
            android:textColor="#6F82AC"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>
